{
  "name": "creo-sis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/core/seed/index.ts",
    "test:prod-guards": "node tests/prod/dev-sign-in-absent.mjs",
    "ai:grant": "tsx src/core/ai/cli.ts grant",
    "ai:revoke": "tsx src/core/ai/cli.ts revoke",
    "ai:list": "tsx src/core/ai/cli.ts list"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/maple-mono": "5.3.0",
    "cmdk": "1.1.1",
    "drizzle-orm": "~0.45.3",
    "next": "^16.4.0",
    "next-intl": "4.14.9",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
