# Copy to .env.local for local development. Never commit real values.

# The app connects as creo_app, which cannot alter or delete audit rows.
DATABASE_URL=postgres://creo_app:creo_app@localhost:5432/creo_dev
# Migrations run as the database owner.
MIGRATION_DATABASE_URL=postgres://creo:creo@localhost:5432/creo_dev

# Vitest uses a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgres://creo_app:creo_app@localhost:5432/creo_test
TEST_MIGRATION_DATABASE_URL=postgres://creo:creo@localhost:5432/creo_test
